# ============================================================
# File: .env.example
# Version: 1.1.0
# Created: 2026-06-25
# Modified: 2026-06-25
# Description: Example environment variables — copy to .env and customize
# NO paid AI API keys required for production use
# ============================================================

# --- Database ---
# SQLite (default, development and production MVP)
DATABASE_URL=sqlite:///data/gmas.db

# PostgreSQL (Phase 3+ migration target — leave blank for SQLite)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/gmas

# --- Application ---
APP_NAME=GMAS
APP_VERSION=1.1.0
LOG_LEVEL=INFO
LOG_FILE=logs/gmas.log

# --- Org Profile ---
# Path to the org profile seed data Markdown file
ORG_PROFILE_PATH=data/org_profile/org_profile_seed_data.md

# --- Feature Flags (Phase 7 / 8 — deferred) ---
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

GOOGLE_DOCS_ENABLED=false
# GOOGLE_DOCS_CREDENTIALS_PATH=data/google_credentials.json
